---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CartAddTo from "../../components/CartAddTo.astro";
import { cachedFetch } from "../../lib/apiCache";

const id = Number(Astro.params.id);
const URL =
	import.meta.env.SECRET_FAKESTORE_API_URL ||
	"https://fakestoreapi.com/products";
const EXTERNAL = `${URL}/${id}`;

const response = await cachedFetch(EXTERNAL, () => fetch(EXTERNAL), 60_000);
const product = await response.json();
---

<BaseLayout title={product.title} description="{product.description}">
	<article class="grid" itemscope itemtype="https://schema.org/Product">
		<div>
			<div class="popout" style="--popout-padding: var(--size-9);">
				<Image
					src={product.image}
					alt={product.title}
					width={600}
					height={600}
					itemprop="image"
					quality="high"
					fetchpriority="high"
					loading="eager"
				/>
			</div>
		</div>
		<div>
			<h1 itemprop="name">{product.title}</h1>

			<p itemprop="category">{product.category}</p>

			<div class="stack">
				<section
					itemprop="aggregateRating"
					itemscope
					itemtype="https://schema.org/AggregateRating"
				>
					<h2 class="sr-only">Product Rating</h2>
					<span
						itemprop="ratingValue"
						style={`--rating: ${product.rating.rate};`}
						aria-label={`Rating of this product is ${product.rating.rate} out of 5.`}
					>
						<span>{product.rating.rate}</span>
					</span>
					<span>
						(<span itemprop="ratingCount"
							>{product.rating.count}</span
						> ratings)
					</span>
				</section>
			</div>

			<section>
				<h2>Description</h2>
				<p itemprop="description">{product.description}</p>
			</section>

			<div class="stack">
				<div
					itemprop="offers"
					itemscope
					itemtype="https://schema.org/Offer"
				>
					<span class="sr-only">Price:</span> $<span itemprop="price"
						>{product.price}</span
					>
					<meta itemprop="priceCurrency" content="USD" />
				</div>
				<CartAddTo
					id={product.id}
					title={product.title}
					price={product.price}
					image={product.image}
				>
					Add to cart
				</CartAddTo>
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	[itemtype="https://schema.org/Product"] {
		margin-block-start: var(--size-fluid-6);
	}
	[itemprop="name"] {
		font-size: var(--font-size-fluid-2);
		margin-block-end: var(--size-fluid-2);
	}

	[itemprop="image"] {
		width: 100%;
		height: auto;
		border-radius: var(--radius-4);
		filter: drop-shadow(0 0 25px var(--gray-7));
	}

	[itemprop="offers"] {
		font-size: var(--font-size-fluid-1);
		color: var(--text-1);
		font-weight: bold;
		margin-block-end: var(--size-fluid-3);

		@media (prefers-color-scheme: dark) {
			text-shadow:
				0 0 10px var(--indigo-5),
				0 0 25px var(--indigo-7);
		}

		@media (prefers-color-scheme: light) {
			text-shadow: 0 0 15px var(--indigo-7);
		}
	}

	[itemprop="category"] {
		padding: var(--size-2);
		border: var(--border-size-1) solid var(--indigo-6);
		border-radius: var(--radius-round);
		display: inline-block;
		text-box: trim-both cap alphabetic;
	}

	[itemprop="aggregateRating"] {
		color: var(--text-2);
	}

	[itemprop="ratingValue"] {
		--size: var(--size-5);
		--color: light-dark(var(--gray-5), var(--gray-6));
		--background: var(--purple-5);
		--percent: calc(var(--rating) / 5 * 100%);

		color: var(--text-1);
		display: inline-block;
		font-size: var(--size);
		line-height: 1;
		font-weight: bold;

		&::after {
			content: "★★★★★";
			letter-spacing: 3px;
			background: linear-gradient(
				90deg,
				var(--background) var(--percent),
				var(--color) var(--percent)
			);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
		}
	}
	[itemprop="description"] {
		margin-block-end: var(--size-fluid-4);
	}
</style>
