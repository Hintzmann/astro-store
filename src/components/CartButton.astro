---

---

<astro-cart-button>
    <button
        class="primary"
        aria-label="View shopping cart"
        commandfor="cart-dialog"
        command="show-modal"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            class="bi bi-basket-fill"
            viewBox="0 0 16 16"
        >
            <path
                d="M5.071 1.243a.5.5 0 0 1 .858.514L3.383 6h9.234L10.07 1.757a.5.5 0 1 1 .858-.514L13.783 6H15.5a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.5.5H15v5a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V9H.5a.5.5 0 0 1-.5-.5v-2A.5.5 0 0 1 .5 6h1.717zM3.5 10.5a.5.5 0 1 0-1 0v3a.5.5 0 0 0 1 0zm2.5 0a.5.5 0 1 0-1 0v3a.5.5 0 0 0 1 0zm2.5 0a.5.5 0 1 0-1 0v3a.5.5 0 0 0 1 0zm2.5 0a.5.5 0 1 0-1 0v3a.5.5 0 0 0 1 0zm2.5 0a.5.5 0 1 0-1 0v3a.5.5 0 0 0 1 0z"
            ></path>
        </svg>
        <span class="badge" hidden>0</span>
    </button>
</astro-cart-button>

<script is:inline>
    (() => {
        customElements.define(
            "astro-cart-button",
            class extends HTMLElement {
                #badge;
                #animationClass = "animate-badge";
                #initialized = false;

                connectedCallback() {
                    this.#badge = this.querySelector(".badge");
                    this.#badge.addEventListener("animationend", this);
                    window.addEventListener("cart:update", this);
                }
                
                handleEvent (e) {
                    if (e.type === "animationend") {
                        this.#badge.classList.remove(this.#animationClass);
                        return;
                    } else if (e.type === "cart:update") {
                        this.#update(e);
                    }
                }

                #update(e) {
                    this.#badge.classList.remove(this.#animationClass);
                    const count = e?.detail?.count|| 0;
                    this.#badge.textContent = String(count);
                    if (count > 0) {
                        this.#badge.removeAttribute("hidden");
                    } else {
                        this.#badge.setAttribute("hidden", "");
                    }
                    // eslint-disable-next-line @typescript-eslint/no-unused-expressions
                    void this.#badge.offsetWidth;
                    // Only animate after the first update
                    if (this.#initialized) {
                        this.#badge.classList.add(this.#animationClass);
                    } else {
                        this.#initialized = true;
                    }
                }
            },
        );
    })();
</script>

<style>
    button {
        font-size: var(--font-size-3);
        position: relative;
    }
    
    .badge {
        background-color: red;
        color: var(--indigo-1);
        border-radius: var(--radius-round);
        padding: var(--size-1) var(--size-2);
        font-size: var(--font-size-0);
        font-weight: var(--font-weight-9);
        left: calc(100% - var(--size-2));
        bottom: calc(100% - var(--size-2));
        position: absolute;
    }

    .animate-badge {
        animation: badge-pop 0.3s ease;
    }
    
    @keyframes badge-pop {
        0% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.4);
        }
        100% {
            transform: scale(1);
        }
    }
</style>
