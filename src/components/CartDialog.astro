---

---

<dialog id="cart-dialog" class="drawer" closedby="any">
    <h2>Shopping Cart</h2>

    <div id="cart-contents">
        <p>Your cart is currently empty.</p>
    </div>

    <div class="cart-actions">
        <button class="primary" id="cart-clear">Clear</button>
        <button class="primary" commandfor="cart-dialog" command="close"
            >Close</button
        >
    </div>

    <script>
        type CartUpdateDetail = { items?: AstroCartItem[] };

        (async () => {
            const contents = document.getElementById(
                "cart-contents",
            ) as HTMLElement | null;
            const clearBtn = document.getElementById(
                "cart-clear",
            ) as HTMLButtonElement | null;

            const getStore = (): HTMLAstroCartElement | null =>
                document.querySelector(
                    "astro-cart",
                ) as HTMLAstroCartElement | null;

            function renderItems(items: AstroCartItem[]) {
                if (!contents) return;

                if (!items || items.length === 0) {
                    contents.innerHTML = "<p>Your cart is currently empty.</p>";
                    return;
                }

                const list = document.createElement("ul");
                list.className = "cart-list list-unstyled stack";

                items.forEach((it) => {
                    const li = document.createElement("li");
                    li.className = "cart-item grid";

                    li.style.setProperty("--grid-min", "12rem");

                    li.innerHTML = `
        <div class="popout">
          <img src="${it.image ?? ""}" alt="" class="cart-item-img"/>    
        </div>
        <div>
          <div class="cart-item-info">
            <div class="cart-item-title"><strong>${String(it.title ?? "")}</strong></div>
            <div class="cart-item-qty">Qty: ${it.quantity}</div>
          </div>
          <div class="cart-item-price">$${it.price}</div>
          <button class="cart-remove" data-remove-id="${it.id}">Remove</button>
        </div>
      `;
                    list.appendChild(li);
                });

                contents.innerHTML = "";
                contents.appendChild(list);
            }

            function updateFromStore(detail: unknown) {
                const d = detail as CartUpdateDetail | null;

                if (d?.items && Array.isArray(d.items)) {
                    renderItems(d.items);
                    return;
                }

                // fallback: try to read the component directly
                const store = getStore();
                if (store && typeof store.get === "function") {
                    renderItems(store.get());
                }
            }

            window.addEventListener("cart:update", (e: Event) => {
                if (e instanceof CustomEvent) updateFromStore(e.detail);
            });

            {
                const store = getStore();
                if (store && typeof store.get === "function") {
                    renderItems(store.get());
                }
            }

            if (clearBtn) {
                clearBtn.addEventListener("click", () => {
                    const store = getStore();
                    if (store && typeof store.clear === "function")
                        store.clear();
                });
            }

            if (contents) {
                contents.addEventListener("click", (ev: MouseEvent) => {
                    const target = ev.target;
                    if (!(target instanceof Element)) return;

                    const btn = target.closest<HTMLElement>("[data-remove-id]");
                    if (!btn) return;

                    const id = btn.dataset.removeId;
                    if (!id) return;

                    const store = getStore();
                    if (store && typeof store.remove === "function")
                        store.removeItem(id);
                });
            }
        })();
    </script>
</dialog>

<style>
    dialog {
        background-color: var(--surface-4);
        border: 1px solid var(--surface-4);
        color: var(--text-1);
        max-height: 100%;
        max-width: 100%;
        padding: var(--size-3);
        width: var(--size-15);

        border-radius: 0;
        max-height: 100%;
        max-width: 100%;
        margin: 0;
        height: 100%;
        inset-inline-end: 0;
        inset-inline-start: auto;
    }

    dialog:modal::backdrop {
        background-color: rgba(0, 0, 0, 0.5);
    }
    h2 {
        margin-block-end: var(--size-8);
    }
</style>
