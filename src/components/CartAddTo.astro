---
interface Props {
    id: number;
    title: string;
    price: number;
    image: string;
}

const { id, title, price, image } = Astro.props;
---

<astro-add-to-cart
    data-id={id}
    data-title={title}
    data-price={price}
    data-image={image}
>
    <button type="button" class="primary">
        <slot />
    </button>
</astro-add-to-cart>

<script is:inline>
    (() => {
        customElements.define(
            "astro-add-to-cart",
            class extends HTMLElement {
                connectedCallback() {
                    const { id, title, price, image } = this.dataset;

                    const button = this.querySelector("button");
                    button.addEventListener("click", () => {
                        const astroCart = document.querySelector("astro-cart");

                        if (!astroCart) {
                            console.error("Cart store not available.");
                            return;
                        }

                        astroCart.add({ id, title, price, image });
                    });
                }
            },
        );
    })();
</script>
